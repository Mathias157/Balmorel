* WeekDecoupled add-on (docs/adr/0006): record the week IS3LOOPSET just solved.

WDWEEK(IS3LOOPSET,'modelstat') = BALBASE4.modelstat;
WDWEEK(IS3LOOPSET,'solvestat') = BALBASE4.solvestat;
WDWEEK(IS3LOOPSET,'resgen')    = BALBASE4.resGen;
WDWEEK(IS3LOOPSET,'resusd')    = BALBASE4.resUsd;
WDWEEK(IS3LOOPSET,'vobj')      = VOBJ.L;

* The week's use of every annual limit, for the recourse on overshoot
WDCO2NA_S(IY411,GROUP,IS3LOOPSET)$(EMI_POLNA(IY411,GROUP,'LIM_CO2') AND (EMI_POLNA(IY411,GROUP,'LIM_CO2') LT INF)) = VWD_CO2NA.L(IY411,GROUP);
WDGMAXF_S(IY411,CCCRRRAAA,FFF,IS3LOOPSET)$IGMAXF(IY411,CCCRRRAAA,FFF) = VWD_GMAXF.L(IY411,CCCRRRAAA,FFF);
$ifi %CCS%==yes WDCCS_S(IY411,IS3LOOPSET)$CCS_STORAGE_MAX(IY411) = VWD_CCS.L(IY411);

* The prices' share of VOBJ, as wd_qobj.inc adds it (inside the objective's year weight)
WDWEEK(IS3LOOPSET,'lambdacost') = SUM(IY411, IOF1_ * IDISCOUNTFACTOR(IY411) * IWEIGHTY(IY411) * (
     SUM(GROUP$(WDLAMBDA_CO2NA(IY411,GROUP) AND EMI_POLNA(IY411,GROUP,'LIM_CO2') AND (EMI_POLNA(IY411,GROUP,'LIM_CO2') LT INF)), WDLAMBDA_CO2NA(IY411,GROUP)*VWD_CO2NA.L(IY411,GROUP))
   + SUM((C,FFF)$(WDLAMBDA_GMAXF(IY411,C,FFF) AND IGMAXF(IY411,C,FFF)), WDLAMBDA_GMAXF(IY411,C,FFF)*VWD_GMAXF.L(IY411,C,FFF))
   + SUM((IR,FFF)$(WDLAMBDA_GMAXF(IY411,IR,FFF) AND IGMAXF(IY411,IR,FFF)), WDLAMBDA_GMAXF(IY411,IR,FFF)*VWD_GMAXF.L(IY411,IR,FFF))
   + SUM((IA,FFF)$(WDLAMBDA_GMAXF(IY411,IA,FFF) AND IGMAXF(IY411,IA,FFF)), WDLAMBDA_GMAXF(IY411,IA,FFF)*VWD_GMAXF.L(IY411,IA,FFF))
$ifi %CCS%==yes   + (WDLAMBDA_CCS(IY411)*VWD_CCS.L(IY411))$(WDLAMBDA_CCS(IY411) AND CCS_STORAGE_MAX(IY411))
   ));

* The week's own cost, as the year's objective counts it
WDWEEK(IS3LOOPSET,'opex') = WDWEEK(IS3LOOPSET,'vobj') - WDWEEK(IS3LOOPSET,'lambdacost') - WDC0;
